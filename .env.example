# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/studentlife_ai?schema=public"

# ─── Auth ─────────────────────────────────────────────────────────────────────
AUTH_SECRET="change-me-to-a-long-random-secret-in-production"
AUTH_SESSION_MAX_AGE="604800"

# ─── App ──────────────────────────────────────────────────────────────────────
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="StudentLife AI"

# ─── Admin / Security (server-only — never NEXT_PUBLIC_) ──────────────────────
ADMIN_MFA_ENCRYPTION_KEY=""
ANALYTICS_HASH_SALT=""
AUDIT_LOG_HASH_SALT=""
RATE_LIMIT_SECRET=""
RATE_LIMIT_LOGIN_IP="20"
RATE_LIMIT_LOGIN_ACCOUNT="10"
RATE_LIMIT_SIGNUP_IP="8"
RATE_LIMIT_ANALYTICS="120"

