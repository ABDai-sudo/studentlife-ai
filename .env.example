# ─── Database ─────────────────────────────────────────────────────────────────
# Local Postgres example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/studentlife_ai?schema=public"
# Neon (recommended for this project): use the connection string from Neon Console.
# Add connect_timeout so cold starts after scale-to-zero have time to wake.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&connect_timeout=30&pool_timeout=20"
# Optional for Prisma Migrate when using a pooled (-pooler) URL:
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:password@localhost:5432/studentlife_ai?schema=public"

# ─── Auth ─────────────────────────────────────────────────────────────────────
AUTH_SECRET="change-me-to-a-long-random-secret-in-production"
AUTH_SESSION_MAX_AGE="604800"

# ─── App ──────────────────────────────────────────────────────────────────────
# Local:
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="StudentLife AI"
# Production (canonical origin already in use — set these on Vercel):
# APP_BASE_URL="https://studentlife-ai.vercel.app"
# NEXT_PUBLIC_APP_URL="https://studentlife-ai.vercel.app"

# ─── Admin / Security (server-only — never NEXT_PUBLIC_) ──────────────────────
ADMIN_MFA_ENCRYPTION_KEY=""
ANALYTICS_HASH_SALT=""
AUDIT_LOG_HASH_SALT=""
RATE_LIMIT_SECRET=""
RATE_LIMIT_LOGIN_IP="20"
RATE_LIMIT_LOGIN_ACCOUNT="10"
RATE_LIMIT_SIGNUP_IP="8"
RATE_LIMIT_ANALYTICS="120"

# ─── AI Money Coach ───────────────────────────────────────────────────────────
# Works with built-in rules without keys. Add a key for LLM answers.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.0-flash"
# AI_PROVIDER="openai"   # or "gemini"

# Optional 3D avatar (production). Leave unset to keep the static image.
# Development uses /avatar/dev-scene.html when this is empty.
# NEXT_PUBLIC_AVATAR_SPLINE_SCENE=""

# FEATURE_CLASS_HUB="true"
# Campus Circle stays off unless this is explicitly "true":
# FEATURE_CAMPUS_CIRCLE="false"
# FEATURE_LEADERBOARD="true"
# FEATURE_STUDY_BUDDY="true"
# FEATURE_WEB_PUSH="false"
# FEATURE_MONEY_GUARDIAN="true"
# FEATURE_STUDY_NOTIFICATIONS="true"
# DEMO_MODE="false"
