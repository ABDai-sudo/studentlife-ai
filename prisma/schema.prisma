// StudentLife AI — Prisma Schema (Phase 1)
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Currency {
  INR
  USD
  GBP
  EUR
  AED
}

enum Country {
  IN
  CA
  US
  UK
  AU
  AE
}

enum StudentType {
  HOSTEL
  DAY_SCHOLAR
}

enum Plan {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  HOSTEL
  EDUCATION
  ENTERTAINMENT
  SHOPPING
  HEALTH
  UTILITIES
  PERSONAL
  OTHER
}

enum IncomeSource {
  POCKET_MONEY
  PART_TIME
  FREELANCE
  SCHOLARSHIP
  GIFT
  OTHER
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  SEMESTER
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  GRADED
  OVERDUE
}

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
  PRACTICAL
  OTHER
}

enum UserRole {
  USER
  OWNER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AuditSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SystemStatusLevel {
  OPERATIONAL
  DEGRADED
  PARTIAL_OUTAGE
  UNAVAILABLE
}

enum PersonalityMode {
  PROFESSIONAL
  FRIENDLY
  CAMPUS_BRO
  CHRONICALLY_ONLINE
  ACADEMIC_VILLAIN
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_BLANK
  ONE_WORD
  VERY_SHORT
  SHORT
  LONG
  CODING
  NUMERICAL
  PRACTICAL
  VIVA
  CASE_STUDY
}

enum PaperMode {
  QUICK_PRACTICE
  CLASS_TEST
  INTERNAL_EXAM
  SEMESTER_MOCK
  CHAPTER_TEST
  VIVA_PRACTICE
  PRACTICAL_EXAM
  REVISION_QUIZ
}

enum AssignmentDraftMode {
  OUTLINE
  GUIDED_DRAFT
  FULL_DRAFT
  EXAM_STYLE
  PRESENTATION
  VIVA_PREP
}

enum QuestStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum StudyBuddyItemKind {
  STUDY_NOW
  DEADLINE
  EXAM
  WEAK_TOPIC
  REVISION
  TIMETABLE
  CONTINUE_SESSION
}

enum DocumentKind {
  PDF
  IMAGE
  NOTES
  QUESTION_PAPER
  SYLLABUS
  ASSIGNMENT
  TEXT
  OTHER
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  passwordHash     String        @map("password_hash")
  name             String?
  emailVerified    Boolean       @default(false) @map("email_verified")
  role             UserRole      @default(USER)
  status           AccountStatus @default(ACTIVE)
  failedLoginCount Int           @default(0) @map("failed_login_count")
  lastLoginAt      DateTime?     @map("last_login_at")
  lastActiveAt     DateTime?     @map("last_active_at")
  suspendedAt      DateTime?     @map("suspended_at")
  mfaEnabled       Boolean       @default(false) @map("mfa_enabled")
  mfaSecretEnc     String?       @map("mfa_secret_enc")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  profile             StudentProfile?
  expenses            Expense[]
  incomes             Income[]
  budgets             Budget[]
  savingsGoals        SavingsGoal[]
  affordabilityChecks AffordabilityCheck[]
  financialScores     FinancialScore[]
  attendanceRecords   AttendanceRecord[]
  assignments         Assignment[]
  exams               Exam[]
  cgpaRecords         CgpaRecord[]
  subjects            Subject[]
  notes               Note[]
  timetableSlots      TimetableSlot[]
  subscriptions       Subscription[]
  streaks             Streak[]
  achievements        Achievement[]
  authSessions        AuthSession[]
  analyticsEvents     AnalyticsEvent[]
  auditLogsAsActor    AuditLog[]               @relation("AuditActor")
  mfaRecoveryCodes    MfaRecoveryCode[]
  aiConversations     AiConversation[]
  uploadedDocuments   UploadedDocument[]
  questionPapers      GeneratedQuestionPaper[]
  assignmentDrafts    AssignmentDraft[]
  quizAttempts        QuizAttempt[]
  flashcardDecks      FlashcardDeck[]
  studySessions       StudySession[]
  dailyQuests         DailyQuest[]
  xpTransactions      XpTransaction[]
  weeklyChallenges    WeeklyChallenge[]
  weeklyRecaps        WeeklyRecap[]
  classHubMemberships ClassHubMember[]
  classAnnouncements  ClassAnnouncement[]
  sharedResources     SharedResource[]
  classReports        ClassHubReport[]
  notificationPreference NotificationPreference?
  notifications       UserNotification[]
  pushSubscriptions   PushSubscription[]
  notificationDeliveries NotificationDelivery[]
  studyBuddyPlans     StudyBuddyPlan[]
  campusSettings      CampusCircleSettings?
  campusConnectionsRequested CampusConnection[] @relation("CampusConnectionRequester")
  campusConnectionsReceived  CampusConnection[] @relation("CampusConnectionAddressee")
  campusBlocksMade    CampusBlock[] @relation("CampusBlocker")
  campusBlocksAgainst CampusBlock[] @relation("CampusBlocked")
  campusReports          CampusReport[] @relation("CampusReportReporter")
  campusReportsReviewed  CampusReport[] @relation("CampusReportReviewer")
  studyInvitesSent    CampusStudyInvite[] @relation("StudyInviteFrom")
  studyInvitesReceived CampusStudyInvite[] @relation("StudyInviteTo")
  quizChallengesSent  CampusQuizChallenge[] @relation("QuizChallengeFrom")
  quizChallengesReceived CampusQuizChallenge[] @relation("QuizChallengeTo")
  recapSharesSent     CampusRecapShare[] @relation("RecapShareFrom")
  recapSharesReceived CampusRecapShare[] @relation("RecapShareTo")
  studyGroupsOwned    CampusStudyGroup[]
  studyGroupMemberships CampusStudyGroupMember[]
  studyGroupInvitesSent CampusStudyGroupInvite[] @relation("GroupInviteBy")
  studyGroupInvitesReceived CampusStudyGroupInvite[] @relation("GroupInviteTo")
  studyGroupActivities CampusStudyGroupActivity[]
  campusReactions     CampusReaction[]

  @@index([role])
  @@index([status])
  @@index([lastActiveAt])
  @@map("users")
}

model StudentProfile {
  id                       String          @id @default(cuid())
  userId                   String          @unique @map("user_id")
  university               String?
  course                   String?
  yearOfStudy              Int?            @map("year_of_study")
  studentType              StudentType     @default(DAY_SCHOLAR) @map("student_type")
  country                  Country         @default(IN)
  currency                 Currency        @default(INR)
  monthlyPocketMoney       Decimal?        @map("monthly_pocket_money") @db.Decimal(12, 2)
  primaryGoal              String?         @map("primary_goal")
  onboardingComplete       Boolean         @default(false) @map("onboarding_complete")
  timezone                 String          @default("Asia/Kolkata")
  institutionName          String?         @map("institution_name")
  boardOrUniversity        String?         @map("board_or_university")
  classOrSemester          String?         @map("class_or_semester")
  preferredExplanationLang String?         @map("preferred_explanation_lang")
  preferredUiLanguage      String?         @map("preferred_ui_language")
  personalityMode          PersonalityMode @default(PROFESSIONAL) @map("personality_mode")
  themeMode                ThemeMode       @default(SYSTEM) @map("theme_mode")
  studyGoal                String?         @map("study_goal")
  dailyStudyMinutes        Int?            @map("daily_study_minutes")
  weakSubjects             String?         @map("weak_subjects") @db.Text
  displayName              String?         @map("display_name")
  shareRecapsEnabled       Boolean         @default(true) @map("share_recaps_enabled")
  leaderboardOptIn         Boolean         @default(false) @map("leaderboard_opt_in")
  /// Curated StudentLife avatar preset id (optional). Initials used when null.
  avatarPresetId           String?         @map("avatar_preset_id")
  /// Optional selfie / photo avatar as a compressed data URL (JPEG).
  avatarImageUrl           String?         @map("avatar_image_url") @db.Text
  /// Optional social status chip (e.g. Locking In) — not a UI language.
  avatarStatus             String?         @map("avatar_status")
  /// When true, live study/class context can overlay the pinned status chip.
  avatarStatusAuto         Boolean         @default(true) @map("avatar_status_auto")
  /// When false, hide avatar image on public leaderboard (show initials).
  leaderboardShowAvatar    Boolean         @default(true) @map("leaderboard_show_avatar")
  xpTotal                  Int             @default(0) @map("xp_total")
  level                    Int             @default(1)
  academicAura             Int             @default(50) @map("academic_aura")
  streakFreezeCount        Int             @default(1) @map("streak_freeze_count")
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

// ─── Finance ─────────────────────────────────────────────────────────────────

model Expense {
  id          String          @id @default(cuid())
  userId      String          @map("user_id")
  amount      Decimal         @db.Decimal(12, 2)
  currency    Currency        @default(INR)
  category    ExpenseCategory
  description String?
  date        DateTime        @default(now()) @db.Date
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, category])
  @@map("expenses")
}

model Income {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  amount      Decimal      @db.Decimal(12, 2)
  currency    Currency     @default(INR)
  source      IncomeSource @default(POCKET_MONEY)
  description String?
  date        DateTime     @default(now()) @db.Date
  isRecurring Boolean      @default(false) @map("is_recurring")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("incomes")
}

model Budget {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  category  ExpenseCategory
  amount    Decimal         @db.Decimal(12, 2)
  currency  Currency        @default(INR)
  period    BudgetPeriod    @default(MONTHLY)
  startDate DateTime        @map("start_date") @db.Date
  endDate   DateTime?       @map("end_date") @db.Date
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, period])
  @@map("budgets")
}

model SavingsGoal {
  id                  String     @id @default(cuid())
  userId              String     @map("user_id")
  title               String
  targetAmount        Decimal    @map("target_amount") @db.Decimal(12, 2)
  currentAmount       Decimal    @default(0) @map("current_amount") @db.Decimal(12, 2)
  currency            Currency   @default(INR)
  monthlyContribution Decimal?   @map("monthly_contribution") @db.Decimal(12, 2)
  targetDate          DateTime?  @map("target_date") @db.Date
  estimatedCompletion DateTime?  @map("estimated_completion") @db.Date
  status              GoalStatus @default(ACTIVE)
  imageUrl            String?    @map("image_url")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("savings_goals")
}

model AffordabilityCheck {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  itemName        String   @map("item_name")
  itemCost        Decimal  @map("item_cost") @db.Decimal(12, 2)
  currentSavings  Decimal  @map("current_savings") @db.Decimal(12, 2)
  monthlySavings  Decimal  @map("monthly_savings") @db.Decimal(12, 2)
  monthsToAfford  Int      @map("months_to_afford")
  fasterScenarios Json?    @map("faster_scenarios") // [{label, months, action}]
  currency        Currency @default(INR)
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("affordability_checks")
}

model FinancialScore {
  id                 String    @id @default(cuid())
  userId             String    @map("user_id")
  score              Int // 0–100
  label              String // Excellent | Good | Fair | Needs Work
  savingsRate        Float?    @map("savings_rate")
  budgetAdherence    Float?    @map("budget_adherence")
  spendingDiscipline Float?    @map("spending_discipline")
  goalProgress       Float?    @map("goal_progress")
  riskLevel          RiskLevel @default(MEDIUM) @map("risk_level")
  moneyLeft          Decimal?  @map("money_left") @db.Decimal(12, 2)
  daysRemaining      Int?      @map("days_remaining")
  safeDailySpend     Decimal?  @map("safe_daily_spend") @db.Decimal(12, 2)
  insights           Json? // AI coach insights array
  periodStart        DateTime  @map("period_start") @db.Date
  periodEnd          DateTime  @map("period_end") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodStart])
  @@map("financial_scores")
}

// ─── Student Life ────────────────────────────────────────────────────────────

model Subject {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String
  code       String?
  instructor String?
  color      String?
  credits    Float?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes          Note[]
  timetableSlots TimetableSlot[]

  @@index([userId])
  @@map("subjects")
}

model Note {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  subjectId String?  @map("subject_id")
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@map("notes")
}

model TimetableSlot {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  subjectId String?  @map("subject_id")
  title     String
  dayOfWeek Int      @map("day_of_week") // 0=Sun … 6=Sat
  startTime String   @map("start_time") // HH:mm
  endTime   String   @map("end_time")
  location  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, dayOfWeek])
  @@map("timetable_slots")
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  subject   String
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  notes     String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subject, date])
  @@index([userId, subject])
  @@map("attendance_records")
}

model Assignment {
  id          String           @id @default(cuid())
  userId      String           @map("user_id")
  title       String
  subject     String?
  description String?
  dueDate     DateTime         @map("due_date")
  status      AssignmentStatus @default(PENDING)
  priority    Int              @default(2) // 1=high, 2=medium, 3=low
  grade       String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([userId, status])
  @@map("assignments")
}

model Exam {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  subject   String
  examType  ExamType @default(MIDTERM) @map("exam_type")
  examDate  DateTime @map("exam_date")
  location  String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, examDate])
  @@map("exams")
}

model CgpaRecord {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  semester   Int
  subject    String
  credits    Float
  grade      String // A+, A, B+, etc. or numeric
  gradePoint Float    @map("grade_point")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, semester])
  @@map("cgpa_records")
}

// ─── Subscriptions & Gamification ────────────────────────────────────────────

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @map("user_id")
  plan               Plan               @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  priceMonthly       Decimal?           @map("price_monthly") @db.Decimal(8, 2)
  currency           Currency           @default(INR)
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  cancelledAt        DateTime?          @map("cancelled_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("subscriptions")
}

model Streak {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  type         String // expense_logging | budget | saving
  currentCount Int       @default(0) @map("current_count")
  bestCount    Int       @default(0) @map("best_count")
  lastLoggedAt DateTime? @map("last_logged_at") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("streaks")
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  code        String // e.g. SAVED_500_WEEK, BUDGET_3_MONTHS
  title       String
  description String?
  unlockedAt  DateTime @default(now()) @map("unlocked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@map("achievements")
}

// ─── AI, Academic tools, Gamification expansion ──────────────────────────────

model AiConversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String   @default("New conversation")
  subject   String?
  pinned    Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String        @id @default(cuid())
  conversationId String        @map("conversation_id")
  role           AiMessageRole
  content        String        @db.Text
  feedback       Int? // 1 up, -1 down
  provider       String?
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model UploadedDocument {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  kind        DocumentKind @default(OTHER)
  fileName    String       @map("file_name")
  mimeType    String       @map("mime_type")
  sizeBytes   Int          @map("size_bytes")
  storageKey  String?      @map("storage_key")
  textExcerpt String?      @map("text_excerpt") @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("uploaded_documents")
}

model AssignmentDraft {
  id            String              @id @default(cuid())
  userId        String              @map("user_id")
  assignmentId  String?             @map("assignment_id")
  title         String
  subject       String?
  institution   String?
  course        String?
  semester      String?
  question      String              @db.Text
  marks         Int?
  wordLimit     Int?                @map("word_limit")
  dueDate       DateTime?           @map("due_date") @db.Date
  format        String?
  instructions  String?             @db.Text
  citationStyle String?             @map("citation_style")
  language      String?
  difficulty    String?
  mode          AssignmentDraftMode @default(GUIDED_DRAFT)
  output        String              @db.Text
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("assignment_drafts")
}

model GeneratedQuestionPaper {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  title           String
  institution     String?
  course          String?
  semester        String?
  subject         String
  unit            String?
  chapter         String?
  topics          String?   @db.Text
  mode            PaperMode @default(QUICK_PRACTICE)
  difficulty      String?
  durationMinutes Int?      @map("duration_minutes")
  totalMarks      Int?      @map("total_marks")
  includeAnswers  Boolean   @default(true) @map("include_answers")
  instructions    String?   @db.Text
  syllabusNote    String?   @map("syllabus_note") @db.Text
  shareToken      String?   @unique @map("share_token")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions GeneratedQuestion[]

  @@index([userId, updatedAt])
  @@map("generated_question_papers")
}

model GeneratedQuestion {
  id          String       @id @default(cuid())
  paperId     String       @map("paper_id")
  orderIndex  Int          @map("order_index")
  type        QuestionType
  prompt      String       @db.Text
  options     Json?
  answer      String?      @db.Text
  explanation String?      @db.Text
  marks       Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  paper GeneratedQuestionPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId, orderIndex])
  @@map("generated_questions")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  paperId     String?  @map("paper_id")
  title       String
  score       Int
  maxScore    Int      @map("max_score")
  durationSec Int?     @map("duration_sec")
  answersJson Json?    @map("answers_json")
