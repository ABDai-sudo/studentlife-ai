  OVERSPENDING
  SAVINGS_GOAL
  UPCOMING_EXPENSE
  SAFE_SPEND_UPDATE
  PRODUCT
  CAMPUS_CIRCLE
}

model NotificationPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")
  pauseAll              Boolean  @default(false) @map("pause_all")
  quietHoursStart       String?  @map("quiet_hours_start")
  quietHoursEnd         String?  @map("quiet_hours_end")
  preferredReminderTime String   @default("19:00") @map("preferred_reminder_time")
  timezone              String   @default("Asia/Kolkata")
  usePersonalityWording Boolean  @default(true) @map("use_personality_wording")
  streakAtRisk          Boolean  @default(true) @map("streak_at_risk")
  streakFinalReminder   Boolean  @default(false) @map("streak_final_reminder")
  dailyQuests           Boolean  @default(true) @map("daily_quests")
  assignmentDeadline    Boolean  @default(true) @map("assignment_deadline")
  upcomingExam          Boolean  @default(true) @map("upcoming_exam")
  focusReminder         Boolean  @default(true) @map("focus_reminder")
  achievement           Boolean  @default(true)
  weeklyRecap           Boolean  @default(true) @map("weekly_recap")
  lowMoney              Boolean  @default(true) @map("low_money")
  overspending          Boolean  @default(true)
  savingsGoal           Boolean  @default(true) @map("savings_goal")
  upcomingExpense       Boolean  @default(true) @map("upcoming_expense")
  safeSpendUpdate       Boolean  @default(false) @map("safe_spend_update")
  campusSocial          Boolean  @default(true) @map("campus_social")
  categoryWarnPercent   Int      @default(70) @map("category_warn_percent")
  categoryHighPercent   Int      @default(90) @map("category_high_percent")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model UserNotification {
  id           String               @id @default(cuid())
  userId       String               @map("user_id")
  category     NotificationCategory
  title        String
  body         String               @db.Text
  href         String?
  readAt       DateTime?            @map("read_at")
  snoozedUntil DateTime?            @map("snoozed_until")
  idempotencyKey String             @map("idempotency_key")
  metadata     Json?
  createdAt    DateTime             @default(now()) @map("created_at")

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("user_notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

model NotificationDelivery {
  id             String              @id @default(cuid())
  userId         String              @map("user_id")
  notificationId String?             @map("notification_id")
  channel        NotificationChannel
  category       NotificationCategory
  idempotencyKey String              @map("idempotency_key")
  status         String              @default("queued")
  errorSafe      String?             @map("error_safe")
  sentAt         DateTime?           @map("sent_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification UserNotification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@unique([userId, channel, idempotencyKey])
  @@index([userId, createdAt])
  @@map("notification_deliveries")
}

